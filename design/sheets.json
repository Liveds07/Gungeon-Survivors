        {"id": "antonio", "companion_name": "Antonio", "weapon_id": "whip", "data_selector": null, "sprite_selector": null, "ability_selector": null},
        {"id": "imelda", "companion_name": "Imelda", "weapon_id": "magic_wand", "data_selector": null, "sprite_selector": null, "ability_selector": null}
